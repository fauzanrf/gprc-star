# =====================================================================
#             KONFIGURASI STARLINK GPRC DASHBOARD & SCRAPER
# =====================================================================

# ── Kredensial Login Starlink ─────────────────────────────────────────
STARLINK_EMAIL=email@example.com
STARLINK_PASSWORD=YourPassword

# ── Mode Headless ─────────────────────────────────────────────────────
HEADLESS=true

# ── Parallelism ───────────────────────────────────────────────────────
PARALLEL_WORKERS=2
WORKER_TIMEOUT_MINUTES=120

# ── Jadwal Scraping Otomatis ──────────────────────────────────────────
# Interval scraping dalam jam (1 = setiap 1 jam)
SCRAPE_INTERVAL_HOURS=1
# Tunggu N detik saat container pertama kali naik sebelum scraping pertama
SCHEDULER_STARTUP_WAIT=30

# ── Database MySQL ────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_ROOT_PASSWORD=rootpassword
DB_USER=starlink
DB_PASSWORD=starlink_pass
DB_NAME=starlink_db

# ── Path File ─────────────────────────────────────────────────────────
STARLINK_STATE_FILE=/app/scraper/auth_state.json
STARLINK_OUTPUT_JSON=/data/starlink_export.json
STARLINK_DASHBOARD_URL=https://starlink.com/account/home
STARLINK_LOGIN_URL=https://www.starlink.com/login

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# ── WhatsApp Notification (via Baileys self-hosted) ───────────────────
# Aktifkan/matikan notifikasi WA
WA_ENABLED=true

# Secret key untuk autentikasi ke WA gateway
# Harus sama antara wa-gateway dan scraper container
WA_API_SECRET=changeme-ganti-dengan-string-random

# JID tujuan pengiriman pesan WA:
#   - Nomor pribadi : 628123456789@s.whatsapp.net
#   - Grup WA       : 120363xxxxxxxxxx@g.us
# Cara mendapatkan group JID: akses GET http://<VPS_IP>:3001/groups
# setelah WA gateway sudah scan QR dan terhubung.
WA_TARGET=120363xxxxxxxxxx@g.us
